<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bib document language: parser, interpreter, frame tree, front matter, session.
       No UI: what a frame draws is plain records, for any renderer to draw. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BibDoc</RootNamespace>
    <AssemblyName>BibDoc</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
