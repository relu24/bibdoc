{
 "name": "late_tasks",
 "source": "for p in data.projects {\n  let open = p.tasks.filter(t => !t.done)\n  let late = open.count(t => t.due < data.today)\n  card(p.name) {\n    if late > 0 { badge(\"{late} late\", tone: \"danger\") } else { badge(\"on track\", tone: \"success\") }\n    list(\"Tasks\") {\n      for t in open {\n        if t.due < data.today { item(t.title, t.title, badge: \"late\", tone: \"danger\") } else { item(t.title, t.title) }\n      }\n    }\n    if late > 0 {\n      if button(\"Nudge\").clicked { send(\"Nudge: {p.name} ({late} late)\") }\n    }\n  }\n}\n",
