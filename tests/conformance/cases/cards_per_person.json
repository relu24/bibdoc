{
 "name": "cards_per_person",
 "source": "for p in data.people {\n  card(p.name) {\n    badge(p.role, tone: p.role == \"admin\" ? \"accent\" : \"muted\")\n    if button(\"Message\").clicked { send(\"Hi {p.name}\") }\n  }\n}\n",
 "data": {
  "people": [
   {
    "name": "Alex",
    "role": "admin"
   },
   {
    "name": "Sam",
    "role": "staff"
   },
   {
    "name": "Kim",
    "role": "admin"
   }
  ]
 },
