{
 "name": "long_compare",
 "source": "let wq = slider(\"Quality weight\", 0, 10, value: 5)\nlet ws = slider(\"Service weight\", 0, 10, value: 3)\nlet wf = slider(\"Fit weight\", 0, 10, value: 2)\nlet score = v => {\n  let total = wq + ws + wf\n  return total == 0 ? 0 : round((v.quality * wq + v.service * ws + v.fit * wf) / total, 1)\n}\nlet top = max(data.vendors.map(score))\nfor v in data.vendors {\n  card(v.name) {\n    stat(\"Score\", score(v))\n    stat(\"Price\", v.price)\n    if score(v) == top { badge(\"best\", tone: accent) }\n  }\n}\nlet pick = choice(\"Pick\", data.vendors.map(v => v.name))\nif button(\"Choose\").clicked { respond(vendor: pick, score: score(data.vendors.find(v => v.name == pick))) }\n",
 "data": {
