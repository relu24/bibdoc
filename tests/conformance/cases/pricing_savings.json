{
 "name": "pricing_savings",
 "source": "let users = slider(\"Users\", 1, 20, value: 4)\nlet per = slider(\"Cases per user\", 1, 40, value: 10)\nlet planName = choice(\"Plan\", data.plans.map(p => p.name))\nlet annual = toggle(\"Annual\")\nlet plan = data.plans.find(p => p.name == planName)\nlet cases = users * per\nlet monthly = (cases * plan.per_case + plan.base) * (annual ? 0.85 : 1)\nstat(\"Cases per month\", cases)\nstat(\"Monthly cost\", monthly)\nstat(\"Yearly cost\", monthly * 12)\nprogress(\"Capacity\", cases, max: data.capacity)\nif cases > data.capacity { badge(\"over capacity\", tone: \"warning\") }\nstat(\"Savings\", annual ? (cases * plan.per_case + plan.base) * 0.15 * 12 : 0)\n",
 "data": {
  "plans": [
   {
    "name": "Basic",
    "per_case": 120,
    "base": 0
   },
   {
    "name": "Pro",
    "per_case": 95,
    "base": 2000
   }
  ],
  "capacity": 300
 },
