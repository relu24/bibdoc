{
 "name": "dashboard",
 "source": "heading(\"Receipts\")\nrow {\n  stat(\"Open\", data.receipts.count(r => r.status == \"open\"))\n  stat(\"Approved\", data.receipts.count(r => r.status == \"approved\"))\n  stat(\"Amount\", data.receipts.sum(r => r.amount))\n}\nlet status = choice(\"Status\", [\"all\", \"open\", \"approved\"])\nlet shown = data.receipts.filter(r => status == \"all\" || r.status == status)\nlet picked = list(\"Receipts\", selectable: true) {\n  for r in shown { item(r.id, \"{r.id} · {r.amount} EUR\") }\n}\nif button(\"Approve\", disabled: picked.selected.length == 0).clicked { call(\"shop.receipts_approve\", ids: picked.selected) }\nif button(\"Export\").clicked { send(\"Export {status} ({shown.length} receipts)\") }\n",
 "data": {
  "receipts": [
