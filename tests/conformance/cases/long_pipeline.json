{
 "name": "long_pipeline",
 "source": "let all = data.investors\nheading(\"Investor pipeline\")\nrow {\n  stat(\"Investors\", all.length)\n  stat(\"In DD\", all.count(i => i.stage == \"dd\"))\n  stat(\"Pipeline\", all.filter(i => [\"meeting\", \"dd\", \"term\"].includes(i.stage)).sum(i => i.ticket))\n}\nlet owner = choice(\"Owner\", [\"Anyone\", ...unique(all.map(i => i.owner))])\nlet minFit = slider(\"Min fit\", 0, 100, value: 50)\nlet matching = all.filter(i => (owner == \"Anyone\" || i.owner == owner) && i.fit >= minFit)\nfor stage in data.stages {\n  let label = data.stage_labels[stage]\n  let here = matching.filter(i => i.stage == stage)\n  section(label) {\n    if here.length > 0 {\n      list(label) {\n        for i in here {\n          item(i.id, i.name, subtitle: \"{i.ticket} EUR · fit {i.fit}\", badge: i.fit >= 80 ? \"hot\" : null, tone: i.fit >= 80 ? success : null)\n        }\n      }\n    } else { text(\"Nobody here\", tone: muted) }\n  }\n}\nlet cands = list(\"Advance candidates\", selectable: true) {\n  for i in matching where i.stage == \"meeting\" || i.stage == \"dd\" { item(i.id, i.name) }\n}\nif button(\"Advance\", disabled: cands.selected.length == 0).clicked { call(\"shop.investors_advance\", ids: cands.selected) }\n",
 "data": {
  "stages": [
   "lead",
   "meeting",
   "dd",
   "term"
  ],
  "stage_labels": {
   "lead": "Leads",
   "meeting": "Meetings",
   "dd": "Due diligence",
   "term": "Term sheet"
  },
