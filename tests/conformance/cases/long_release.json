{
 "name": "long_release",
 "source": "let r = data.release\nlet cs = data.changes\ncard(\"Release {r.version}\", subtitle: r.date) {\n  kv([{label: \"Features\", value: cs.count(c => c.kind == \"feature\")},\n      {label: \"Fixes\", value: cs.count(c => c.kind == \"fix\")},\n      {label: \"Chores\", value: cs.count(c => c.kind == \"chore\")}])\n  let hide = toggle(\"Hide chores\", value: true)\n  let shown = cs.filter(c => !hide || c.kind != \"chore\")\n  table([\"Change\", \"Kind\", \"Risk\", \"Tested\"], shown.map(c => [c.title, c.kind, c.risk, c.tested ? \"yes\" : \"no\"]))\n  progress(\"Tested\", shown.count(c => c.tested), max: shown.length)\n  let blockers = shown.filter(c => c.risk == \"high\" && !c.tested)\n  if blockers.length > 0 {\n    badge(\"blocked\", tone: danger)\n    list(\"Blockers\") { for b in blockers { item(b.id, b.title) } }\n  } else {\n    badge(\"ready\", tone: success)\n    if button(\"Ship\").clicked { respond(version: r.version, shipped: shown.map(c => c.id)) }\n  }\n}\n",
