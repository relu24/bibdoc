{
 "name": "extra-layout_grid",
 "source": "let layer = choice(\"Layer\", [\"All\", \"Company\", \"Team\"])\nrow(fit: true) {\n  for c in data.cases { badge(c, tone: muted) }\n}\nfor l in data.layers where layer == \"All\" || layer == l {\n  section(l) {\n    grid(columns: 3) {\n      for a in data.actors where a.layer == l {\n        card(a.name, subtitle: a.sub, badge: a.state, badgeTone: a.state == \"open\" ? warning : success, footer: \"**Track:** {a.track}\") {\n          text(a.does)\n          chips(a.laws, tone: muted)\n          if a.verify { chips([\"verify\"], tone: warning) }\n        }\n      }\n    }\n  }\n}\n",
