 "name": "budget_sections",
 "source": "for cat in data.categories {\n  let ps = data.purchases.filter(p => p.category == cat)\n  let sub = ps.sum(p => p.cost)\n  section(cat) {\n    table([\"Item\", \"Cost\"], ps.map(p => [p.name, p.cost]))\n    stat(\"Subtotal\", sub)\n    if sub > data.budgets[cat] { badge(\"over budget\", tone: \"danger\") }\n  }\n}\nstat(\"Grand total\", data.purchases.sum(p => p.cost))\n",
