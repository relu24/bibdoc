<Project Sdk="Microsoft.NET.Sdk">
  <!-- The conformance cases, and the rules they do not reach. In this folder: dotnet run, Release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BibDoc/BibDoc.csproj" />
    <None Include="cases/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="cases" />
  </ItemGroup>
</Project>
